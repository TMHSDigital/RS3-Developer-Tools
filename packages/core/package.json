{
  "name": "@tmhs/rs3-devtools-core",
  "version": "0.1.0",
  "description": "Shared logic for RS3 Developer Tools: manifest validation, scaffolding, dev_plugins sync, preflight checks, packaging, and the docs cache",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "TMHSDigital",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TMHSDigital/RS3-Developer-Tools.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@tmhs/rs3-plugin-schema": "0.1.0",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "cheerio": "^1.0.0",
    "chokidar": "^4.0.0",
    "fflate": "^0.8.2"
  }
}
