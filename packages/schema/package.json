{
  "name": "@tmhs/rs3-plugin-schema",
  "version": "0.1.0",
  "description": "JSON Schema (draft 2020-12) for the RuneScape 3 plugin.json manifest",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin.schema.json": "./plugin.schema.json"
  },
  "files": [
    "dist",
    "plugin.schema.json",
    "rs3dev.schema.json",
    "settings.sample.json",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "license": "MIT",
  "author": "TMHSDigital",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TMHSDigital/RS3-Developer-Tools.git",
    "directory": "packages/schema"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0"
  }
}
