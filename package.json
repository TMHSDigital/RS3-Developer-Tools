{
  "name": "rs3-developer-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Lua-native developer toolkit for official RuneScape 3 plugins: LuaLS stubs, manifest schema, rs3dev CLI, MCP server, and Cursor/Claude Code guidance",
  "type": "module",
  "license": "MIT",
  "author": "TMHSDigital",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TMHSDigital/RS3-Developer-Tools.git"
  },
  "homepage": "https://github.com/TMHSDigital/RS3-Developer-Tools#readme",
  "bugs": {
    "url": "https://github.com/TMHSDigital/RS3-Developer-Tools/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "workspaces": [
    "packages/schema",
    "packages/core",
    "packages/stubs-generator",
    "packages/luals-stubs",
    "packages/cli",
    "packages/mcp"
  ],
  "scripts": {
    "postinstall": "node scripts/link-workspaces.mjs",
    "link": "node scripts/link-workspaces.mjs",
    "build": "node scripts/build-all.mjs",
    "typecheck": "node scripts/build-all.mjs --typecheck",
    "test": "vitest run",
    "stubs:generate": "node packages/stubs-generator/dist/cli.js --out packages/luals-stubs",
    "stubs:check": "node packages/stubs-generator/dist/cli.js --out packages/luals-stubs --check",
    "luals:check": "node scripts/luals-check.mjs examples/hello-counter",
    "test:coverage": "vitest run --coverage",
    "test:packages": "npm test --workspaces --if-present",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^5.0.5",
    "ajv": "^8.17.0",
    "ajv-formats": "^3.0.0",
    "cheerio": "^1.0.0",
    "chokidar": "^6.0.0",
    "commander": "^15.0.0",
    "fflate": "^0.8.2",
    "typescript": "^5.6.0",
    "vitest": "^5.0.0",
    "zod": "^4.0.0"
  }
}
